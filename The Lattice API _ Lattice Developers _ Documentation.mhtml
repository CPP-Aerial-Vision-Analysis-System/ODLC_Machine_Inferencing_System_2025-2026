@keyframes collapsible-closed {=20
  0% { height: var(--radix-collapsible-content-height); opacity: 1; }
  100% { opacity: 0; height: 0px; }
}

@keyframes collapsible-open {=20
  0% { opacity: 0; height: 0px; }
  100% { height: var(--radix-collapsible-content-height); opacity: 1; }
}

@keyframes slide-up {=20
  0% { transform: translateY(0px); }
  100% { transform: translateY(-100%); }
}

@keyframes slide-down {=20
  0% { transform: translateY(-150%); }
  100% { transform: translateY(0px); }
}

@keyframes collapsible-child-slide-up {=20
  0% { width: var(--radix-collapsible-content-width,auto); transform: trans=
lateY(0px); }
  100% { width: var(--radix-collapsible-content-width,auto); transform: tra=
nslateY(-100%); }
}

@keyframes collapsible-child-slide-down {=20
  0% { width: var(--radix-collapsible-content-width,auto); transform: trans=
lateY(-100%); }
  100% { width: var(--radix-collapsible-content-width,auto); transform: tra=
nslateY(0px); }
}

@keyframes toc-slide-in-up {=20
  0% { transform: translateY(100%); }
  100% { transform: translateY(0px); }
}

@keyframes toc-slide-out-up {=20
  0% { transform: translateY(0px); }
  100% { transform: translateY(-100%); }
}

@keyframes toc-slide-in-down {=20
  0% { transform: translateY(-100%); }
  100% { transform: translateY(0px); }
}

@keyframes toc-slide-out-down {=20
  0% { transform: translateY(0px); }
  100% { transform: translateY(100%); }
}

