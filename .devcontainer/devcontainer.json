{
  "name": "ASTRA ODLC dev",
  // Our own image (docker/Dockerfile). Only the `dev` target is built here —
  // `sitl` and `sim` are opt-in, see docker/Dockerfile.
  "build": {
    "dockerfile": "../docker/Dockerfile",
    "context": "../docker",
    "target": "dev"
  },
  "runArgs": [
    // GUI windows (image_view etc.) go to an X server on the host:
    // XQuartz on macOS, VcXsrv/XLaunch on Windows.
    "--env=DISPLAY=host.docker.internal:0.0",
    // ROS 2 (Fast DDS) passes images through shared memory; Docker's 64 MB
    // default is too small.
    "--shm-size=1g"
  ],
  // Persist bash history and the ccache in named volumes so they survive
  // rebuilds. Volumes need no host-side files, so this works the same on
  // macOS and Windows.
  "remoteEnv": {
    "HISTFILE": "/commandhistory/.bash_history"
  },
  "mounts": [
    "source=odlc-bashhistory,target=/commandhistory,type=volume",
    "source=odlc-ccache,target=/home/ubuntu/.cache/ccache,type=volume"
  ],
  "remoteUser": "ubuntu",
  "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/${localWorkspaceFolderBasename}",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Make the volumes writable by the container user.
  "postCreateCommand": "sudo mkdir -p /commandhistory && sudo touch /commandhistory/.bash_history && sudo chown -R ubuntu /commandhistory /home/ubuntu/.cache/ccache"
}
