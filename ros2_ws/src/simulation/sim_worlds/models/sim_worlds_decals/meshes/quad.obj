# unit quad for ground patches (scale it)
# generated by sim_worlds/worldgen/meshes.py (metres, z up)
mtllib quad.mtl
usemtl white
v -0.5000 -0.5000 0.0000
v 0.5000 -0.5000 0.0000
v 0.5000 0.5000 0.0000
v -0.5000 0.5000 0.0000
vt 0.00000 0.00000
vt 1.00000 0.00000
vt 1.00000 1.00000
vt 0.00000 1.00000
vn 0.0000 0.0000 1.0000
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
