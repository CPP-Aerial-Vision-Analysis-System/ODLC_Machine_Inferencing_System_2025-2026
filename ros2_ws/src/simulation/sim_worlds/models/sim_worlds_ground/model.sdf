<?xml version="1.0"?>
<!-- models/sim_worlds_ground/model.sdf - PURPOSE: flat grass ground, 12000 m square, centred on the world origin: a plane for physics and a mesh on which the seamless grass picture repeats every 160 m.
     GENERATED by sim_worlds/worldgen/builder.py (write_shared_models) - do not edit by hand. -->
<sdf version="1.9">
  <model name="sim_worlds_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>12000 12000</size></plane>
        </geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="grass">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>meshes/ground.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.04 0.04 0.04 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/grass_albedo.jpg</albedo_map>
            <roughness>0.97</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
