<?xml version="1.0" ?>
<!--
  worlds/suas_field_real.sdf - PURPOSE: the SUAS 2026 competition field (Skyway36, Tulsa OK) on REAL terrain:
  USGS lidar ground, NAIP 2023 aerial-photo colour, the real trees and buildings (models rf_ground, rf_trees,
  rf_buildings, built by build_real_field.py assets). Local frame ENU, origin = centre of the Runway 2 VTOL pad
  = SITL home. Two search boundaries, each with one hiker (Rescue Randy mannequin) and one open pop-up tent among
  debris, vehicles, bushes and people; the flight line with its canopies; the three wooden poles in Search Boundary 1.
  The drone is NOT in this file: the bringup spawns model "iris" at config/suas_field_real.yaml spawn.
  GENERATED by sim_worlds/realfield/world_build.py (scripts/build_real_field.py world) - edit that and re-run it.
-->
<sdf version="1.9">
  <world name="suas_field_real">
    <gui fullscreen="0">
      <!-- 3D view: starts with an overview of the field; once the drone exists the bringup makes it follow -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.45 0.45 0.45</ambient_light>
        <background_color>0.62 0.74 0.90</background_color>
        <camera_pose>-55.000 45.000 42.000 0.000 0.247 -0.785</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>6000</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <!-- follow the drone: the bringup calls the gz service /gui/follow (request gz.msgs.StringMsg
           data "iris", reply gz.msgs.Boolean); the offset and gain below are used then -->
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
        <follow_target>iris</follow_target>
        <follow_offset>-12 0 6</follow_offset>
        <follow_pgain>0.02</follow_pgain>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <!-- THE DRONE'S POINT OF VIEW: live picture of the gimbal camera (1280 x 720, 25 Hz) -->
      <plugin filename="ImageDisplay" name="Drone camera (live)">
        <gz-gui>
          <title>Drone camera (live)</title>
          <property type="bool" key="showTitleBar">true</property>
          <property type="bool" key="resizable">true</property>
          <property type="double" key="width">640</property>
          <property type="double" key="height">400</property>
          <property type="double" key="z">2</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
        <topic>/sim/camera/video/image</topic>
        <topic_picker>false</topic_picker>
      </plugin>
    </gui>

    <!-- 1 ms physics steps at real-time factor 1: ArduPilot SITL runs in lock-step with these steps -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GPS origin = world (0, 0, 0) = the centre of the take-off pad at ground level.
         SITL gets the SAME numbers as its home option: 36.2147411,-96.0067230,210.2,0 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>36.2147411</latitude_deg>
      <longitude_deg>-96.0067230</longitude_deg>
      <elevation>210.2</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.46 0.47 0.49 1</ambient>
      <background>0.62 0.74 0.90 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <sky></sky>
    </scene>

    <!-- mid-September late-morning sun from the south-east (about 50 degrees up) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <visualize>false</visualize>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 0.96 0.88 1</diffuse>
      <specular>0.35 0.33 0.30 1</specular>
      <direction>-0.570 0.444 -0.691</direction>
    </light>

    <!-- ground, pad, runway -->
    <include>
      <name>rf_ground</name>
      <uri>model://rf_ground</uri>
      <static>true</static>
      <pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </include>
    <include>
      <name>rf_trees</name>
      <uri>model://rf_trees</uri>
      <static>true</static>
      <pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </include>
    <include>
      <name>rf_buildings</name>
      <uri>model://rf_buildings</uri>
      <static>true</static>
      <pose>0.0000 0.0000 0.0000 0.0000 0.0000 0.0000</pose>
    </include>
    <include>
      <name>runway_2_pad</name>
      <uri>model://sim_worlds_pad</uri>
      <static>true</static>
      <pose>0.0000 0.0000 -0.0000 0.0000 0.0000 0.0000</pose>
    </include>

    <!-- objects: the hiker and the tent (targets), people, vehicles, debris, markers -->
    <!-- DISTRACTOR: wooden utility pole, 10.2 m (real, from the lidar) -->
    <model name="sb1_pole_a">
      <static>true</static>
      <pose>250.5800 -246.4500 7.5863 0.0000 0.0000 0.0000</pose>
      <link name="link">
        <collision name="pole_col">
          <pose>0.0000 0.0000 5.1000 0.0000 0.0000 0.0000</pose>
          <geometry>
            <cylinder><radius>0.150</radius><length>10.200</length></cylinder>
          </geometry>
        </collision>
        <visual name="pole">
          <pose>0.0000 0.0000 5.1000 0.0000 0.0000 0.0000</pose>
          <geometry>
            <cylinder><radius>0.150</radius><length>10.200</length></cylinder>
          </geometry>
          <material>
            <ambient>0.300 0.220 0.150 1</ambient>
            <diffuse>0.300 0.220 0.150 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
            <pbr><metal>
              <roughness>0.90</roughness><metalness>0.0</metalness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
