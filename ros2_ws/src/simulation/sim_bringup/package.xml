<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!--
  sim_bringup/package.xml  PURPOSE: the ROS 2 package manifest of sim_bringup, the "start button" of the
  ASTRA simulator. It lists what the package needs at run time: Gazebo + the ROS<->Gazebo bridge, RViz,
  xacro (to build the drone model file), MAVROS messages (for the phase monitor and readiness checks),
  pymavlink (the mission upload / arm tool) and the other simulation packages it starts.
  The other simulation packages are exec_depend only, and the launch file keeps working (with a clear
  message) when one of them is not built.
-->
<package format="3">
  <name>sim_bringup</name>
  <version>0.1.0</version>
  <description>
    One-command bring-up of the ASTRA Gazebo simulator: Gazebo Harmonic with the Iris + SIYI A8 mini
    model, ArduCopter SITL, MAVProxy, the SIYI camera emulator, the payload release, the ROS bridge,
    RViz and the demo panel. Also holds the helper tools used by simulation/scripts (mission upload and
    arming over MAVLink, the terminal phase monitor, readiness checks, photo trigger).
  </description>
  <maintainer email="astra-sim@example.com">ASTRA simulation team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- pymavlink comes from pip (docker/requirements-dev.txt), so it is not listed as a rosdep key. -->

  <!-- The other simulation packages (sim_models, sim_worlds, siyi_emulator, sim_demo) are deliberately NOT
       listed: they are optional at run time (sim.launch.py reports a missing one and uses a stand-in or skips
       it), and listing them would make colcon refuse to build sim_bringup whenever one of them is broken. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
