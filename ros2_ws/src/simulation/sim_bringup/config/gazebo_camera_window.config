<?xml version="1.0"?>
<!--
  sim_bringup/config/gazebo_camera_window.config  PURPOSE: a small Gazebo window that shows ONLY the drone's live
  gimbal camera (/sim/camera/video/image). sim.launch.py opens it with gui_camera:=window, next to a main Gazebo
  window that keeps its usual layout minus the camera panel (the world's own <gui>, or gazebo_gui_no_camera.config).
  Why a separate window: on the team laptop (WSL2, Mesa D3D12 driver) the camera panel INSIDE the main Gazebo
  window sometimes draws old pictures of the 3D view instead of the camera picture (the "flashes between outside
  and camera POV" fault, docs/simulation/TROUBLESHOOTING.md). This window has no 3D view in its program; read in
  the same seconds as the main window's panel (2026-10-31), it kept showing the camera while the panel did not.
-->

<window>
  <width>700</width>
  <height>460</height>
  <style material_theme="Dark" material_primary="DeepOrange" material_accent="LightBlue"/>
  <menus>
    <drawer default="false"/>
  </menus>
  <dialog_on_exit>false</dialog_on_exit>
</window>

<!-- The drone's live camera fills the window. -->
<plugin filename="ImageDisplay" name="Drone camera (live)">
  <gz-gui>
    <title>Drone camera (live)</title>
    <property type="bool" key="showTitleBar">true</property>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <topic>/sim/camera/video/image</topic>
  <topic_picker>false</topic_picker>
</plugin>
