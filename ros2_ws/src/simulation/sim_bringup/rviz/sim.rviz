# sim_bringup/rviz/sim.rviz -- PURPOSE: the RViz layout of the ASTRA simulator (opened by sim.launch.py rviz:=true).
# What you see: on the right a BIG live camera POV (/sim/camera/image, the drone's gimbal camera) with the
# newest photo (/sim/camera/photo) under it; in the middle a 3D view that follows the drone, with the demo
# markers (/sim/demo/markers from sim_demo demo_markers: search area, true target positions, detections,
# photo footprints, drone track), the drone's TF frame (from odom_tf) and a 10 m grid; the Displays list on
# the left. Fixed frame "world" = the Gazebo world frame (x east, y north, z up, metres; origin = SITL home);
# the 3D view's target frame "base_link" is the drone (published by odom_tf from /sim/drone/odometry).
# The dock layout at the bottom (QMainWindow State) is generated by test/gen_rviz_window_state.py.
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
    Tree Height: 400
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 10
      Class: rviz_default_plugins/Grid
      Color: 170; 170; 175
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid (10 m cells)
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Demo markers (search area, targets, detections, footprints, track)
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sim/demo/markers
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 3
      Name: Drone frame (TF)
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Angle Tolerance: 0.2
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: Drone (odometry arrow)
      Position Tolerance: 0.2
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.1
        Color: 255; 110; 20
        Head Length: 1.2
        Head Radius: 0.8
        Shaft Length: 2.5
        Shaft Radius: 0.35
        Value: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /sim/drone/odometry
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera POV (live)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /sim/camera/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Newest photo (photo camera)
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /sim/camera/photo
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 42; 50
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.05
      Pitch: 0.75
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 3.9
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 60
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Focal Shape Fixed Size: false
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Follow the drone
        Near Clip Distance: 0.05
        Pitch: 0.75
        Target Frame: base_link
        Value: Orbit (rviz)
        Yaw: 3.9
      - Class: rviz_default_plugins/Orbit
        Distance: 320
        Enable Stereo Rendering:
          Stereo Eye Separation: 0.06
          Stereo Focal Distance: 1
          Swap Stereo Eyes: false
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Focal Shape Fixed Size: true
        Focal Shape Size: 0.05
        Invert Z Axis: false
        Name: Whole field (top view)
        Near Clip Distance: 0.05
        Pitch: 1.45
        Target Frame: world
        Value: Orbit (rviz)
        Yaw: 4.71
Window Geometry:
  Camera POV (live):
    collapsed: false
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Newest photo (photo camera):
    collapsed: false
  Tool Properties:
    collapsed: true
  Views:
    collapsed: true
  Width: 1700
  X: 60
  Y: 40
