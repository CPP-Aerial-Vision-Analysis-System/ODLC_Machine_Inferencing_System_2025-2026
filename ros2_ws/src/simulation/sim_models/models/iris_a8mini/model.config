<?xml version="1.0"?>
<!--
  sim_models/models/iris_a8mini/model.config -- PURPOSE: the Gazebo model description file.
  Gazebo reads it when something asks for model://iris_a8mini (for example a world file
  with <include><uri>model://iris_a8mini</uri></include>) and then loads model.sdf.
  model.sdf is GENERATED from model.sdf.xacro with the default arguments
  (regenerate: ros2 run sim_models generate_model_sdf --update-default).
-->
<model>
  <name>iris_a8mini</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>ASTRA SUAS team (ODLC simulation)</name>
  </author>
  <description>
    ArduPilot Iris quadcopter (ardupilot_gazebo iris_with_ardupilot, flown by ArduCopter SITL
    through the JSON link) with a SIYI A8 mini 3-axis gimbal, a live video camera, a triggered
    photo camera and two droppable payloads (water bottle on servo 11, beacon on servo 13).
    Needs model://iris_with_standoffs from ardupilot_gazebo and the ArduPilotPlugin.
  </description>
</model>
