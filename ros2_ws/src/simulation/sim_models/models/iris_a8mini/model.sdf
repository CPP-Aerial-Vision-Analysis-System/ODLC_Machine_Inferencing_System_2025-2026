<?xml version="1.0" ?>
<!--
  model.sdf: GENERATED FILE, do not edit by hand.
  PURPOSE: the simulated ASTRA drone for Gazebo Harmonic (ArduPilot Iris + SIYI A8 mini
  gimbal with a live video camera and a triggered photo camera + two droppable payloads).
  Source: sim_models/models/iris_a8mini/model.sdf.xacro (read that file and README.md).
  Regenerate: ros2 run sim_models generate_model_sdf [options] (see README.md).
  Photo camera: 2560 x 1440.  ArduPilotPlugin UDP port: 9002.
  Arguments:
    camera_model:=zr10 camera_noise_stddev:=0.005 fdm_port_in:=9002
    gimbal_initial_pitch:=0.0 hfov:=1.4137 payload_person_mass:=0.5
    payload_tent_mass:=0.12 payloads:=true photo_height:=0 photo_width:=0 video_fps:=25
    video_height:=720 video_width:=1280
-->
<sdf version="1.9">
  <!-- canonical_link: the Iris body must stay the model's reference link, because
       ArduPilotPlugin and OdometryPublisher report the pose of the canonical link. -->
  <model canonical_link="iris_with_standoffs::base_link" name="iris_a8mini">
    <!-- The 3DR Iris airframe from ardupilot_gazebo: base_link (1.5 kg body with
         4 legs), imu_link with imu_sensor, rotor_0..3 on rotor_N_joint. -->
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>
    <!-- ========================= SIYI A8 mini gimbal ========================== -->
    <!-- Chain (same links, joint origins and meshes as siyi_ros2/urdf/a8_mini.urdf.xacro):
         base_link =(gimbal_mount, fixed)=> gimbal_base =(gimbal_yaw, Z)=> gimbal_yaw_link
         =(gimbal_roll, X)=> gimbal_roll_link =(gimbal_pitch, 0 -1 0)=> gimbal_pitch_link (camera head) -->
    <link name="gimbal_base">
      <pose>0.07 0 -0.0674 0 0 0</pose>
      <inertial>
        <pose>0 0 0.011 0 0 0</pose>
        <mass>0.040</mass>
        <inertia>
          <ixx>1.0e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.6e-5</iyy>
          <iyz>0</iyz>
          <izz>1.8e-5</izz>
        </inertia>
      </inertial>
      <!-- one box around the whole gimbal, so the camera head never sinks into the
           ground if the drone tips over (top kept 3 mm below the body) -->
      <collision name="gimbal_collision">
        <pose>0 0 -0.0138 0 0 0</pose>
        <geometry>
          <box>
            <size>0.060 0.056 0.078</size>
          </box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://iris_a8mini/meshes/a8_mini_base.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="gimbal_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>gimbal_base</child>
    </joint>
    <!-- Yaw stage: the yaw motor sits in the base, the arm hangs below it. -->
    <link name="gimbal_yaw_link">
      <pose relative_to="gimbal_base">0 0 -0.011 0 0 0</pose>
      <inertial>
        <pose>-0.009 0 -0.016 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>2.0e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.0e-5</iyy>
          <iyz>0</iyz>
          <izz>2.0e-5</izz>
        </inertia>
      </inertial>
      <visual name="yaw_visual">
        <pose>0 0 0.011 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://iris_a8mini/meshes/a8_mini_yaw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="gimbal_yaw" type="revolute">
      <parent>gimbal_base</parent>
      <child>gimbal_yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.7925</lower>
          <upper>2.7925</upper>
          <effort>0.5</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <!-- Roll stage: the roll motor is on the arm, behind the camera. -->
    <link name="gimbal_roll_link">
      <pose relative_to="gimbal_yaw_link">-0.018 0 -0.027 0 0 0</pose>
      <inertial>
        <pose>0.017 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>2.0e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.0e-5</iyy>
          <iyz>0</iyz>
          <izz>2.0e-5</izz>
        </inertia>
      </inertial>
      <visual name="roll_visual">
        <pose>0.018 0 0.038 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://iris_a8mini/meshes/a8_mini_roll.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="gimbal_roll" type="revolute">
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.5236</lower>
          <upper>0.5236</upper>
          <effort>0.5</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <!-- Pitch stage = the camera head. Axis 0 -1 0, so + pitch tilts the lens UP. -->
    <link name="gimbal_pitch_link">
      <pose relative_to="gimbal_roll_link">0.027 -0.025 0.001 0 0 0</pose>
      <inertial>
        <pose>0.001 0.025 0 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>3.0e-5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.0e-5</iyy>
          <iyz>0</iyz>
          <izz>3.0e-5</izz>
        </inertia>
      </inertial>
      <visual name="pitch_visual">
        <pose>-0.009 0.025 0.037 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://iris_a8mini/meshes/a8_mini_pitch.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- the lens: a small black disc on the front face -->
      <visual name="lens_visual">
        <pose relative_to="a8mini_camera_link">0.002 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1.0</ambient>
          <diffuse>0.02 0.02 0.02 1.0</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <sensor name="video_camera" type="camera">
        <pose relative_to="a8mini_camera_link">0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>25</update_rate>
        <visualize>0</visualize>
        <topic>/sim/camera/video/image</topic>
        <gz_frame_id>a8mini_camera_optical_frame</gz_frame_id>
        <camera name="a8mini_video">
          <camera_info_topic>/sim/camera/video/camera_info</camera_info_topic>
          <optical_frame_id>a8mini_camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.4137</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
      <sensor name="photo_camera" type="camera">
        <pose relative_to="a8mini_camera_link">0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
        <topic>/sim/camera/photo/image</topic>
        <gz_frame_id>a8mini_camera_optical_frame</gz_frame_id>
        <camera name="a8mini_photo">
          <triggered>true</triggered>
          <trigger_topic>/sim/camera/photo/trigger</trigger_topic>
          <camera_info_topic>/sim/camera/photo/camera_info</camera_info_topic>
          <optical_frame_id>a8mini_camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.4137</horizontal_fov>
          <image>
            <width>2560</width>
            <height>1440</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>3000</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
    <joint name="gimbal_pitch" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>gimbal_pitch_link</child>
      <axis>
        <xyz>0 -1 0</xyz>
        <limit>
