<?xml version="1.0" ?>
<!--
  sim_models/test/worlds/sim_models_test.sdf

  PURPOSE: the small world used by the sim_models acceptance tests (test/acceptance/).
  It copies the settings of ardupilot_gazebo's iris_runway.sdf (1 ms physics for ArduPilot
  lock step, the same systems, the CMAC airfield location and the runway) and adds simple,
  brightly coloured targets whose positions are known, so a test can check where the camera
  looks by finding them in the images:

    ground squares (2 x 2 m, 5 m from the spawn point, seen when the camera looks down):
        red     5 m NORTH  (0, 5)       magenta 5 m EAST  (5, 0)
        blue    5 m SOUTH  (0, -5)      cyan    5 m WEST  (-5, 0)
    poles (1.5 m wide, 30 m tall, 60 m away, seen when the camera looks straight ahead):
        red     straight NORTH          (0, 60)
        magenta 30 deg WEST of north    (-30, 51.96)
    an inspection camera (fixed, triggered) that photographs the drone at the spawn point.

  The drone is NOT in this file: the test spawns it at (0, 0, 0.195) facing north (yaw 90 deg),
  exactly like iris_runway.sdf places the Iris. Coordinates: x = East, y = North, z = Up (ENU).
  All targets use emissive colours, so they look the same whatever the light.
-->
<sdf version="1.9">
  <world name="sim_models_test">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- CMAC airfield (ArduPilot's standard SITL location), heading 0 = x East, y North -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground: the ardupilot_gazebo runway + grass airfield, placed as in iris_runway.sdf -->
    <include>
      <uri>model://runway</uri>
      <pose degrees="true">-29 545 0 0 0 363</pose>
    </include>

    <!-- coloured ground squares around the spawn point -->
    <model name="marker_north_red">
      <static>true</static>
      <pose>0 5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 2 0.02</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
      </link>
    </model>
    <model name="marker_east_magenta">
      <static>true</static>
      <pose>5 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 2 0.02</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material>
        </visual>
      </link>
    </model>
    <model name="marker_south_blue">
      <static>true</static>
      <pose>0 -5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 2 0.02</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse><emissive>0 0 1 1</emissive></material>
        </visual>
      </link>
    </model>
    <model name="marker_west_cyan">
      <static>true</static>
      <pose>-5 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 2 0.02</size></box></geometry>
          <material><ambient>0 1 1 1</ambient><diffuse>0 1 1 1</diffuse><emissive>0 1 1 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- inspection camera: a fixed, TRIGGERED camera 1.8 m from the spawn point, looking at the
         drone from the front-right and slightly above. It renders only when triggered (no cost
         otherwise); the acceptance test takes one picture before take-off and one after landing.
         gz topics: /sim_models_test/inspection/trigger (gz.msgs.Boolean) -> .../image -->
    <model name="inspection_camera">
      <static>true</static>
      <pose>1.0 1.3 0.75 0 0.36 -2.227</pose>
      <link name="link">
        <sensor name="inspection" type="camera">
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <topic>/sim_models_test/inspection/image</topic>
          <camera name="inspection">
            <triggered>true</triggered>
            <trigger_topic>/sim_models_test/inspection/trigger</trigger_topic>
            <horizontal_fov>0.55</horizontal_fov>
            <image><width>1600</width><height>1200</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>500</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- poles for the forward-looking camera checks -->
    <model name="pole_north_red">
      <static>true</static>
      <pose>0 60 15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.5 1.5 30</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><emissive>1 0 0 1</emissive></material>
        </visual>
      </link>
    </model>
    <model name="pole_nnw_magenta">
      <static>true</static>
      <pose>-30 51.9615 15 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.5 1.5 30</size></box></geometry>
          <material><ambient>1 0 1 1</ambient><diffuse>1 0 1 1</diffuse><emissive>1 0 1 1</emissive></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
