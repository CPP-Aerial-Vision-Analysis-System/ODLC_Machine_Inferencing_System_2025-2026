<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="debug" default="false"/>
  <arg name="run_detection" default="true"/>
  <arg name="yolo_model" default="yolo11s.pt"/>
  <arg name="conf_thres" default="0.25"/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- Main Controller Node - handles detection response and waypoint injection -->
  <node pkg="main" exec="main_controller" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Object Detection Node (SAHI) - detects person/tent in aerial imagery -->
  <node if="$(var run_detection)" pkg="detection" exec="object_detection_sahi" output="screen">
    <param name="model_path" value="$(var yolo_model)"/>
    <param name="confidence_threshold" value="$(var conf_thres)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Waypoint Manager - manages mission waypoints -->
  <node pkg="waypoint_mavros" exec="waypoint" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- Optional: Debug visualization of detections -->
  <node if="$(var debug)" pkg="image_view" exec="image_view" output="screen">
    <remap from="image" to="/detection_result_image"/>
  </node>

  <!-- <node pkg="wp_sender" exec="test_param" output="screen"></node> -->

  <!-- <node pkg="gps_ros2" exec="gpstest" output="screen"></node> -->

  <!-- <node pkg="detection" exec="object_detection_sahi" output="screen"></node> -->

  <!-- <node pkg="detection" exec="new_od" output="screen"></node> -->

  <node pkg="main" exec="main_controller.py" output="screen"></node>

  <!-- <node pkg="video_cam" exec="image_pub" output="screen"></node> -->

  <!-- <node pkg="video_cam" exec="siyi" output="screen"></node> -->

  <!-- <node pkg="mapping" exec="trigger" output="screen"></node> -->

  <!-- <node pkg="mapping" exec="mapping" output="screen"></node> -->

</launch>
