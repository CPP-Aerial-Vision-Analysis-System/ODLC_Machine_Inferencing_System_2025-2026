<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ortho_mapping</name>
  <version>0.1.0</version>
  <description>
    Batch GPS-georeferenced orthomosaic builder. Runs AFTER the mapping flight:
    collects every image in video_cam's mapping_photos directory and renders one
    final, north-up, georeferenced map image (JPEG + .jgw world file).
  </description>
  <maintainer email="aregar20012001@gmail.com">aro</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>mavros_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
