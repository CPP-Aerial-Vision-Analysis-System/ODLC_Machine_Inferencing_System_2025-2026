# Camera control service definition
# Allows control of SIYI camera and gimbal functions from other ROS2 nodes

# Request
string command      # e.g. capture, autofocus, zoom_manual, gimbal_rotate,
					# gimbal_set_angles, laser_distance, sd_format
string parameter    # Optional command parameter, usually CSV text
					# e.g. "15,-20", "lock", "on", "yes"

---

# Response
bool success        # True if command executed successfully
string message      # JSON payload with detailed result or error
