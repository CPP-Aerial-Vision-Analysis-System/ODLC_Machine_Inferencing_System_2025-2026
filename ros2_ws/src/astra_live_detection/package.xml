<?xml version="1.0"?>
<package format="3">
  <name>astra_live_detection</name><version>0.1.0</version>
  <description>Live ROS image input for ASTRA SAHI and YOLO detection.</description>
  <maintainer email="maintainer@example.com">ASTRA</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
