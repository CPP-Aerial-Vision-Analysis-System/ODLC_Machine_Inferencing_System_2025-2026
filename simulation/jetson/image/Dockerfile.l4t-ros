# =============================================================================
#  simulation/jetson/image/Dockerfile.l4t-ros  --  layer 1 of the Jetson image (arm64): L4T JetPack + ROS 2 Humble
#
#  PURPOSE: the base the team's dev stack (layer 2 = docker/Dockerfile target "dev") is built on for the REAL Jetson
#  Orin Nano: NVIDIA's L4T JetPack container (Ubuntu 22.04 with CUDA 12.6, cuDNN 9.3 and TensorRT 10.3 inside the
#  image, matching the board's JetPack 6.2.x / L4T R36.4.x; the host only gives the GPU driver through the NVIDIA
#  container runtime) plus ROS 2 Humble ros-base from packages.ros.org, rosdep and colcon. The result plays the role
#  that ros:humble-ros-base-jammy plays for the PC image, so docker/Dockerfile stays ONE definition for both.
#  It is built ON THE PC through QEMU emulation (`jetson.sh image build`), never on the board (owner, 11:31).
#  First step: the OpenCV dry run of HIL_DESIGN.md risk 17: l4t-jetpack ships NVIDIA's OpenCV (nvidia-opencv-dev),
#  ros-humble-cv-bridge needs Ubuntu's libopencv-dev. With PURGE_NVIDIA_OPENCV=auto (default) NVIDIA's OpenCV is
#  removed only when apt says the two cannot be installed together, so the image matches the drone (Ubuntu OpenCV
#  4.5.4 for C++, pip opencv-python for Python, as docker/Dockerfile's header records); the build log says which.
#  THE SAME FILE builds layer 1 of the PC's "virtual Jetson" (owner, 12:32: the PC container must be the Jetson's
#  software version for version): BASE_IMAGE=nvcr.io/nvidia/tensorrt:24.08-py3 = Ubuntu 22.04 with CUDA 12.6, cuDNN 9.3
#  and TensorRT 10.3 for x86 GPUs (NGC release notes 24.08; selftest prints what the built image really has).
#  Build (through jetson.sh):  docker build --platform linux/arm64 -f Dockerfile.l4t-ros -t astra-hil-l4t-ros:r36.4.0 .
#                  PC flavor:  docker build -f Dockerfile.l4t-ros --build-arg BASE_IMAGE=nvcr.io/nvidia/tensorrt:24.08-py3
#                                  -t astra-hil-trt-ros:24.08 .
# =============================================================================
ARG L4T_TAG=r36.4.0
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:${L4T_TAG}
FROM ${BASE_IMAGE}
ARG L4T_TAG

ARG BASE_IMAGE
ARG ROS_DISTRO=humble
ARG PURGE_NVIDIA_OPENCV=auto
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    ROS_DISTRO=${ROS_DISTRO}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# --- the ROS 2 apt source (same key and repo as the official ros images) -------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg lsb-release locales \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu jammy main" \
         > /etc/apt/sources.list.d/ros2.list \
    && rm -rf /var/lib/apt/lists/*

# --- risk 17: can Ubuntu's OpenCV (needed by cv_bridge) sit next to NVIDIA's? -----------------------------------------
RUN apt-get update \
    && if apt-get install -s -y --no-install-recommends ros-${ROS_DISTRO}-cv-bridge > /tmp/opencv_dryrun.txt 2>&1; then \
         echo "OpenCV dry run: ros-${ROS_DISTRO}-cv-bridge installs next to NVIDIA's OpenCV"; \
         if [ "${PURGE_NVIDIA_OPENCV}" = yes ]; then apt-get purge -y 'nvidia-opencv*' 'libopencv*' || true; fi; \
       else \
         echo "OpenCV dry run: CONFLICT (see below); removing NVIDIA's OpenCV so the image matches the drone"; \
         tail -20 /tmp/opencv_dryrun.txt; \
         if [ "${PURGE_NVIDIA_OPENCV}" = no ]; then echo "PURGE_NVIDIA_OPENCV=no: stopping" >&2; exit 1; fi; \
         apt-get purge -y 'nvidia-opencv*' 'libopencv*' || true; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# --- ROS 2 Humble ros-base + the tools the official ros-base image has ----------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        python3-rosdep python3-colcon-common-extensions python3-colcon-mixin python3-vcstool \
        build-essential git python3-pip \
    && rosdep init \
    && rm -rf /var/lib/apt/lists/*

# Like the official image: ROS on PATH in every shell (layer 2 also sources it in ~/.bashrc).
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc
LABEL org.astra.owner="hil" org.astra.layer="gpu-ros" org.astra.base="${BASE_IMAGE}"
CMD ["bash"]
